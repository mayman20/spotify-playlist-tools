# Load these into the backend service environment; never into the Vite build.
APP_ENV=production
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=https://your-api.example/auth/callback
FRONTEND_URL=https://your-site.example
# Generate a random value and keep it stable: changing it invalidates sessions
# and makes stored encrypted Spotify refresh tokens unreadable.
APP_SECRET_KEY=
# Postgres (including Supabase Postgres) or a persistent SQLite volume.
DATABASE_URL=sqlite:////var/lib/spotify-toolkit/accounts.db
