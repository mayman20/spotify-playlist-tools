# Local scripts only. Copy to .env and fill in your existing Spotify app.
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback
# Require the intended account ID before enabling any monthly playlist writes.
SPOTIFY_EXPECTED_USER_ID=
# Optional recommendation fallback. The main engine uses playlist co-occurrence.
LASTFM_API_KEY=
